# Which settings to load: management.settings.dev locally, .prod on a server
DJANGO_SETTINGS_MODULE=management.settings.dev

# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL settings for docker-compose
MYSQL_DATABASE=master_db
MYSQL_USER=master_user
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_HOST=db
MYSQL_PORT=3306

# Redis for Celery
REDIS_URL=redis://redis:6379/0

# Default admin account (created on startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Production only (management.settings.prod): the frontend's address(es)
# CORS_ALLOWED_ORIGINS=https://stock.example.com
